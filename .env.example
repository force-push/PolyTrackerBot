# PolyTracker Bot Configuration

# Telegram Settings
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHANNEL_ID=YOUR_CHANNEL_ID_HERE

# Polymarket API Settings
POLYMARKET_DATA_API_BASE=https://data-api.polymarket.com
POLYMARKET_GAMMA_API_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_BASE=https://clob.polymarket.com

# Wallet Scoring Thresholds
MIN_WIN_RATE=0.60
MIN_TOTAL_PNL=5000
MIN_TRADES=25
MIN_AVG_POSITION=200
MIN_VOLUME_30D=2000
MAX_WALLETS_TRACKED=50

# Signal Filtering
MIN_SIGNAL_POSITION=500
MIN_MARKET_LIQUIDITY=10000
MIN_HOURS_REMAINING=48

# Scheduler Settings
DISCOVER_WALLETS_INTERVAL_HOURS=6
RESCORE_WALLETS_INTERVAL_HOURS=24
POLL_TRADES_INTERVAL_MINUTES=5
CHECK_MARKET_CLOSURES_INTERVAL_HOURS=1
DAILY_DIGEST_HOUR_UTC=8

# Database
DATABASE_PATH=./data/polytracker.db
LOG_LEVEL=INFO

# API Rate Limiting
MAX_REQUESTS_PER_SECOND=10
LEADERBOARD_LIMIT=100

# Retry Settings
HTTP_TIMEOUT_CONNECT=5
HTTP_TIMEOUT_READ=30
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5

# Feature Flags
ENABLE_DAILY_DIGEST=true
ENABLE_HIGH_CONVICTION_ALERTS=true
ALERT_ON_POSITION_SIZE_CHANGES=false
